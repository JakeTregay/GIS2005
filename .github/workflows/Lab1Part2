<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>ArcGIS Maps SDK for JavaScript Tutorials: Display a map</title>

    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }

      .banner {
        width: 800px;
        height: 150px;
        object-fit: cover;
        display: block;
        margin: 0 auto;
      }

      arcgis-map {
        width: 800px;
        height: 400px;
        display:block;
        margin: 0 auto;
      }
      .description {
        width: 800px;
        margin: 20px auto;
        font-family: Arial, sans-serif;
      }
    </style>

    <!-- Load the ArcGIS Maps SDK for JavaScript from CDN -->
    <script type="module" src="https://js.arcgis.com/5.1/"></script>
  </head>

  <body>

    <img src="Banner photo for lab1 part2/dji_fly_20240725_120306_178_1784080829159_photo.JPG" class="banner" alt="Local Map Banner">

    <arcgis-map item-id="0aef785949ac4ee5bd16e029586de35f" 
                center="-105.280712, 40.013911" 
                zoom="10">
      <arcgis-zoom slot="top-left"></arcgis-zoom>
    </arcgis-map>
      <div class="description">
      <h2>Colorado Resort Map Viewer</h2>
      <p>
        This map displays trail locations, playgrounds and surrounding terrain in BoulderColorado.
      </p>

      <p>
        <strong>Layer Highlight:</strong>  
        The primary layer in this webmap shows the terrain around Boulder. These layers help
        visualize elevation, land cover, important playgrounds and trails to go have fun around.
      </p>
    </div>

    
    <script type="module">
      const viewElement = document.querySelector("arcgis-map");

      const locString = window.location;
      console.log("locString=" + locString);
      const urlParams = new URLSearchParams(locString.search);
      let resort = urlParams.get("resort");
      console.log(resort);
      if (resort=="winterpark") {
        viewElement.goTo(
          // go to point with a custom animation duration
          { center: [-105.76, 39.89] },
          { duration: 5000 },
          );
      }
      if (resort=="snowmass") {
        viewElement.goTo(
          // go to point with a custom animation duration
          { center: [-106.9513, 39.1956] },
          { duration: 5000 },
          );
      }
viewElement.zoom = 13;

    </script>
  </body>

</html>
